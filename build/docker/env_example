# Docker Compose environment overrides

# PostgreSQL service
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=retinal_db
DB_PORT=5432

# Flask application service
FLASK_PORT=8080
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password_example

# Processing service
PROCESSING_SERVICE_PORT=5000
AZURE_STORAGE_SAS_TOKEN=your-sas-token

# Fundus DR inference service ("Detekcia") - uses the redis of this stack
# Put the model checkpoint into FUNDUS_CHECKPOINT_DIR and the concept activation cache
# (<key>.npz + <key>.json) into FUNDUS_ACTIVATION_CACHE_DIR. Do not rename these files.
FUNDUS_CHECKPOINT_DIR=./fundus-dr-inference/models
FUNDUS_ACTIVATION_CACHE_DIR=./fundus-dr-inference/activation_cache
FUNDUS_CHECKPOINT_FILE=earthy-sweep-1-epoch=16-val_loss=0.55.ckpt
FUNDUS_AUTH_TOKEN=
FUNDUS_PORT=8000
FUNDUS_REDIS_DB=1
FUNDUS_INFERENCE_TIMEOUT_S=300
FUNDUS_INFERENCE_N_STEPS=5
REDIS_MAXMEMORY=512mb

# Shared logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# Paths are relative to /app inside the container; ./logs is bind-mounted to
# build/docker/logs/ on the host so files survive container crashes.
# LOG_FILE=logs/flask.log        # for flask-app (default)
# LOG_FILE=logs/classifier.log   # for classifier-service (default)

# pgAdmin service
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050